<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <NoWarn>IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer Include="$(UnityAnalyzers)\Unity.Analyzers.Common.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityManaged)\UnityEngine.*Module.dll" Private="false" />
    <Reference Include="$(UnityManaged)\Unity.Scripting.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyDllToDebugBuildTestStage" AfterTargets="Build"
    Condition="'$(Configuration)' == 'Debug'">

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(DebugBuildTestStage)" />
  </Target>

</Project>