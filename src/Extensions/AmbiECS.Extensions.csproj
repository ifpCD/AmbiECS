<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <NoWarn>IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityManaged)\UnityEngine.*Module.dll" Private="false" />
    <Reference Include="$(UnityManaged)\Unity.Scripting.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\AmbiECS.Core.csproj" />
    <ProjectReference Include="..\Generator\AmbiECS.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
